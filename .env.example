DATABASE_URL=postgresql://           # Neon connection string
NEXTAUTH_SECRET=                    # random secret (openssl rand -base64 32)
NEXTAUTH_URL=https://pokeinvestment.vercel.app   # or http://localhost:3000 for dev
POKEMON_TCG_API_KEY=                # from pokemontcg.io (free)
PRICE_TRACKER_API_KEY=              # from pokemonpricetracker.com (optional, paid)
YOUTUBE_API_KEY=          # YouTube Data API v3 key (free, Google Cloud)
ADMIN_EMAIL=              # email allowed to access /hub/admin
CRON_SECRET=              # shared secret guarding /api/cron/* routes
